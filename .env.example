# Folder containing your bank/credit-card statements (PDF and/or CSV).
# Quote it if the path contains spaces. Supports ~ expansion.
STATEMENTS_DIR="~/Documents/Financial Statements/Aug 2026"

# "claude_cli" (default, uses your Claude Pro subscription via the Claude Code CLI)
# or "anthropic_api" (uses ANTHROPIC_API_KEY below, billed per token).
LLM_PROVIDER=claude_cli

# Only needed when LLM_PROVIDER=anthropic_api.
ANTHROPIC_API_KEY=

# Optional. If set, overrides the model used for BOTH categorization and the
# narrative summary. Leave unset to use the built-in per-task defaults
# (a small/fast model for categorization, a stronger model for the narrative).
ANTHROPIC_MODEL=

# Where the local SQLite database file lives (created automatically).
DB_PATH=data/ledger.db

HOST=127.0.0.1
PORT=8000
